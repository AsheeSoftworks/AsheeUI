{
  "name": "@asheeui/cli",
  "version": "0.6.6",
  "description": "Scaffold and maintain AsheeUI in an existing React app, with framework detection, provider wiring, and a doctor command.",
  "author": "Ashee Softworks <asheesoftworks@gmail.com>",
  "homepage": "https://asheeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheeSoftworks/AsheeUI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AsheeSoftworks/AsheeUI/issues"
  },
  "keywords": [
    "asheeui",
    "cli",
    "scaffold",
    "codegen",
    "react",
    "tailwindcss",
    "nextjs",
    "vite",
    "tanstack-start",
    "setup"
  ],
  "bin": {
    "asheeui": "./dist/index.mjs"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "provenance": true,
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --clean",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
