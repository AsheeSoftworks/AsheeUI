{
  "name": "@asheeui/cli",
  "version": "0.7.1",
  "description": "Scaffold and maintain AsheeUI in an existing React app, with framework detection, provider wiring, a doctor command, and a playground command that copies an official playground application.",
  "author": "Ashee Softworks <asheesoftworks@gmail.com>",
  "homepage": "https://asheeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheeSoftworks/AsheeUI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AsheeSoftworks/AsheeUI/issues"
  },
  "keywords": [
    "asheeui",
    "cli",
    "scaffold",
    "codegen",
    "react",
    "tailwindcss",
    "nextjs",
    "vite",
    "tanstack-start",
    "setup",
    "playground",
    "playgrounds"
  ],
  "bin": {
    "asheeui": "./dist/index.mjs"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "provenance": true,
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --clean",
    "prepublishOnly": "pnpm build",
    "sync:playground-templates": "node scripts/sync-playground-templates.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "^15.0.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0"
}
