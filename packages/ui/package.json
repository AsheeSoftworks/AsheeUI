{
  "name": "asheeui",
  "version": "0.4.2",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "style": "./src/index.css",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "import": "./src/config/index.ts",
      "default": "./src/config/index.ts"
    },
    "./libs": {
      "types": "./src/libs/index.ts",
      "import": "./src/libs/index.ts",
      "default": "./src/libs/index.ts"
    },
    "./styles.css": "./src/index.css",
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "style": "./dist/index.css",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles": {
        "style": "./dist/index.css",
        "default": "./dist/index.css"
      },
      "./config": {
        "types": "./dist/config/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./libs": {
        "types": "./dist/libs/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:registry": "tsx src/scripts/build-registry.ts",
    "build": "vite build"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@asheeui/utils": "workspace:*"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.20",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@floating-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.20",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "module": "./src/index.ts"
}
