{
  "name": "asheeui",
  "version": "0.7.0",
  "description": "Accessible and customizable React primitives engineered with Tailwind CSS.",
  "author": "Ashee Softworks <asheesoftworks@gmail.com>",
  "homepage": "https://asheeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheeSoftworks/AsheeUI.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/AsheeSoftworks/AsheeUI/issues"
  },
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "design-system",
    "ui-kit",
    "tailwindcss",
    "tailwind",
    "typescript",
    "accessible",
    "a11y",
    "floating-ui",
    "headless"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./styles.css": "./src/index.css",
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "provenance": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "style": "./dist/index.css",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles": {
        "style": "./dist/index.css",
        "default": "./dist/index.css"
      },
      "./styles.css": "./dist/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:registry": "tsx src/scripts/build-registry.ts",
    "build": "vite build"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.20",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0"
  },
  "module": "./src/index.ts",
  "license": "MIT"
}
