{
  "name": "asheeui",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "style": "./src/index.css",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./styles.css": "./src/index.css",
    "./src": "./src",
    "./src/index.ts": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "dependencies": {
    "@asheeui/utils": "workspace:*"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.20",
    "framer-motion": "^11.0.0 || ^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    },
    "@floating-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.20",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "framer-motion": "^11.18.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
