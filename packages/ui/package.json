{
  "name": "asheeui",
  "version": "3.1.0",
  "description": "The AsheeUI umbrella package: the portable surface of @asheeui/web and @asheeui/native behind one import, routed by the bundler instead of by a runtime check.",
  "author": "Ashee Softworks <asheesoftworks@gmail.com>",
  "homepage": "https://asheeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheeSoftworks/AsheeUI.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/AsheeSoftworks/AsheeUI/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "expo",
    "component-library",
    "design-system",
    "ui-kit",
    "tailwindcss",
    "nativewind",
    "typescript",
    "accessible",
    "a11y"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.native.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./src/index.native.ts",
        "default": "./src/index.native.ts"
      },
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": {
      "style": "./styles.css",
      "default": "./styles.css"
    },
    "./styles.css": "./styles.css",
    "./section-kit": {
      "react-native": {
        "types": "./src/section-kit.native.ts",
        "default": "./src/section-kit.native.ts"
      },
      "types": "./src/section-kit.ts",
      "import": "./src/section-kit.ts",
      "default": "./src/section-kit.ts"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "react-native": {
          "types": "./dist/index.native.d.ts",
          "default": "./dist/index.native.js"
        },
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles": {
        "style": "./styles.css",
        "default": "./styles.css"
      },
      "./styles.css": "./styles.css",
      "./section-kit": {
        "react-native": {
          "types": "./dist/section-kit.native.d.ts",
          "default": "./dist/section-kit.native.js"
        },
        "types": "./dist/section-kit.d.ts",
        "import": "./dist/section-kit.js",
        "default": "./dist/section-kit.js"
      },
      "./tailwind-preset": "./tailwind-preset.cjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/index.native.ts",
    "src/section-kit.ts",
    "src/section-kit.native.ts",
    "styles.css",
    "tailwind-preset.cjs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-umbrella.mjs && tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@asheeui/core": "workspace:^"
  },
  "peerDependencies": {
    "@asheeui/native": "workspace:^",
    "@asheeui/web": "workspace:^",
    "nativewind": ">=4.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.78.0",
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "@asheeui/native": {
      "optional": true
    },
    "@asheeui/web": {
      "optional": true
    },
    "nativewind": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@asheeui/native": "workspace:^",
    "@asheeui/web": "workspace:^",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "nativewind": "^4.2.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
