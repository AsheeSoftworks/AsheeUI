{
  "name": "@asheeui/native",
  "version": "2.3.0",
  "description": "React Native components styled with NativeWind, sharing the AsheeUI design language and component contracts.",
  "author": "Ashee Softworks <asheesoftworks@gmail.com>",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./section-kit": {
      "types": "./src/components/section-kit/index.ts",
      "import": "./src/components/section-kit/index.ts",
      "default": "./src/components/section-kit/index.ts"
    }
  },
  "publishConfig": {
    "provenance": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./section-kit": {
        "types": "./dist/components/section-kit/index.d.ts",
        "import": "./dist/components/section-kit/index.js",
        "default": "./dist/components/section-kit/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@asheeui/core": "workspace:^"
  },
  "peerDependencies": {
    "nativewind": ">=4.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.78.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/runtime": "^8.0.5",
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "nativewind": "^4.2.7",
    "react": "^19.3.0",
    "react-native": "0.86.3",
    "tailwindcss": "^4.3.3",
    "test-renderer": "^1.0.0",
    "typescript": "^7.0.2"
  }
}
