{
  "name": "@asheeui/native",
  "version": "2.8.0",
  "description": "React Native components styled with NativeWind, sharing the AsheeUI design language and component contracts.",
  "author": "Ashee Softworks <asheesoftworks@gmail.com>",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./section-kit": {
      "types": "./src/components/layouts/section-kit/index.ts",
      "import": "./src/components/layouts/section-kit/index.ts",
      "default": "./src/components/layouts/section-kit/index.ts"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "react-native": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./section-kit": {
        "types": "./dist/components/layouts/section-kit/index.d.ts",
        "import": "./dist/components/layouts/section-kit/index.js",
        "default": "./dist/components/layouts/section-kit/index.js"
      },
      "./tailwind-preset": "./tailwind-preset.cjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run && jest",
    "test:logic": "vitest run",
    "test:native": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@asheeui/core": "workspace:^"
  },
  "peerDependencies": {
    "nativewind": ">=4.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.78.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/runtime": "^8.0.7",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "nativewind": "^4.2.7",
    "react": "^19.3.1",
    "react-native": "0.88.0",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
