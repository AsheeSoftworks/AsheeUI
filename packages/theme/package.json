{
  "name": "@asheeui/theme",
  "version": "0.1.0",
  "description": "Optional theme editing UI for AsheeUI: colour fields, a theme switcher, theme cards and a controlled editor for runtime themes.",
  "author": "Ashee Softworks <asheesoftworks@gmail.com>",
  "homepage": "https://asheeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheeSoftworks/AsheeUI.git",
    "directory": "packages/theme"
  },
  "bugs": {
    "url": "https://github.com/AsheeSoftworks/AsheeUI/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "expo",
    "theme",
    "theme-editor",
    "color-picker",
    "design-system",
    "asheeui"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "provenance": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/components",
    "src/lib",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.native.json --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run && jest",
    "test:web": "vitest run",
    "test:native": "jest",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@asheeui/core": "workspace:^",
    "asheeui": "workspace:^",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@asheeui/core": "workspace:^",
    "@asheeui/native": "workspace:^",
    "@asheeui/web": "workspace:^",
    "@babel/core": "^8.0.7",
    "@babel/runtime": "^8.0.7",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "asheeui": "workspace:^",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jsdom": "^30.1.3",
    "nativewind": "^4.2.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
