{
  "name": "@asheeui/puck",
  "version": "2.3.0",
  "description": "The AsheeUI Puck integration: one block registry behind one import, routed by the bundler so an editor composes a page on the web and a device renders the stored page with the native components.",
  "author": "Ashee Softworks <asheesoftworks@gmail.com>",
  "homepage": "https://asheeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheeSoftworks/AsheeUI.git",
    "directory": "packages/puck"
  },
  "bugs": {
    "url": "https://github.com/AsheeSoftworks/AsheeUI/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "expo",
    "puck",
    "page-builder",
    "visual-editor",
    "component-library",
    "design-system",
    "tailwindcss",
    "nativewind",
    "typescript"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.native.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./src/index.native.ts",
        "default": "./src/index.native.ts"
      },
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "provenance": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "react-native": {
          "types": "./dist/index.native.d.ts",
          "default": "./dist/index.native.js"
        },
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/index.native.ts",
    "src/shared",
    "src/web",
    "src/native",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run && jest",
    "test:web": "vitest run",
    "test:native": "jest",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@asheeui/core": "workspace:^",
    "@asheeui/native": "workspace:^",
    "@asheeui/web": "workspace:^"
  },
  "peerDependencies": {
    "@puckeditor/core": "^0.23.0",
    "nativewind": ">=4.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.78.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@puckeditor/core": {
      "optional": true
    },
    "nativewind": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/runtime": "^7.29.7",
    "@puckeditor/core": "^0.23.0",
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "jsdom": "^30.0.1",
    "nativewind": "^4.2.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.86.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
