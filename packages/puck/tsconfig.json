{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "jest", "nativewind/types"],
    "paths": {
      "@asheeui/core": ["../core/dist/index.d.ts"],
      "@asheeui/web": ["../web/dist/index.d.ts"],
      "@asheeui/web/section-kit": [
