{
  "name": "@asheeui/core",
  "version": "3.1.0",
  "description": "Platform-neutral design language, component contracts and cascade helpers shared by the AsheeUI web and native packages.",
  "author": "Ashee Softworks \u003casheesoftworks@gmail.com\u003e",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dev": {
      "types": "./src/dev.ts",
      "import": "./src/dev.ts",
      "default": "./src/dev.ts"
    }
  },
  "publishConfig": {
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./dev": {
        "types": "./dist/dev.d.ts",
        "import": "./dist/dev.js",
        "default": "./dist/dev.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {}
}
