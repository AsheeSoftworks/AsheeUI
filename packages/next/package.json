{
  "name": "@asheeui/next",
  "version": "0.2.16",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsdown src/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@asheeui/utils": "workspace:*",
    "jiti": "^2.4.0"
  },
  "peerDependencies": {
    "asheeui": "workspace:*",
    "next": "^16.0.0",
    "postcss": "^8.4.0"
  },
  "peerDependenciesMeta": {
    "asheeui": {
      "optional": true
    },
    "postcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "next": "16.3.1",
    "postcss": "^8.4.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.0.0"
  }
}
