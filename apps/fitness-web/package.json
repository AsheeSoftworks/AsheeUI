{
  "name": "@asheeui/fitness-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The fitness tracker on the web: a TanStack Start application that imports the umbrella package and renders the shared screens with a top navigation bar.",
  "scripts": {
    "dev": "tsr generate && vite dev",
    "build": "tsr generate && vite build",
    "preview": "vite preview",
    "routes": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit",
    "check-types": "tsr generate && tsc --noEmit"
  },
  "dependencies": {
    "@asheeui/fitness-shared": "workspace:^",
    "@asheeui/puck": "workspace:^",
    "@asheeui/web": "workspace:^",
    "@puckeditor/core": "^0.23.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "asheeui": "workspace:^",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
