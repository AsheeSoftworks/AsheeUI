{
  "name": "@asheesoftworks/asheeui",
  "version": "2.1.0",
  "description": "Accessible and customizable React primitives engineered with Tailwind CSS.",
  "license": "Apache-2.0",
  "author": "Ashee Softworks asheesoftworks@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheeSoftworks/AsheeUI.git"
  },
  "homepage": "https://asheeui.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "biome lint",
    "lint:class-vocabulary": "node scripts/lint-class-vocabulary.mjs",
    "check": "biome check",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify:native-routing": "node scripts/verify-native-routing.mjs",
    "check:changesets": "node scripts/check-changesets.mjs",
    "check:core-charter": "node scripts/check-core-charter.mjs",
    "check:native-parity": "node scripts/check-native-parity.mjs",
    "check:native-artifact": "node scripts/check-native-artifact.mjs",
    "check:types": "turbo run check-types",
    "check:umbrella": "node scripts/check-umbrella.mjs",
    "fix": "biome check --write",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "turbo": "latest",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.20.0"
}
