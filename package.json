{
  "name": "asheeui-ecosystem",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpx @biomejs/biome lint --write",
    "check": "pnpx @biomejs/biome check --write",
    "format": "pnpx @biomejs/biome format --write",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "publish": "pnpm -r build && changeset publish",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.15.3",
    "turbo": "latest",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "packageManager": "pnpm@11.20.0",
  "license": "MIT"
}
