{
  "name": "@asheesoftworks/asheeui",
  "version": "2.0.0",
  "description": "Accessible and customizable React primitives engineered with Tailwind CSS.",
  "license": "Apache-2.0",
  "author": "Ashee Softworks asheesoftworks@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheeSoftworks/AsheeUI.git"
  },
  "homepage": "https://asheeui.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "biome lint",
    "check": "biome check",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify:released": "node scripts/verify-released.mjs",
    "check:changesets": "node scripts/check-changesets.mjs",
    "format": "biome format --write",
    "fix": "biome check --write",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "release:notes": "node scripts/sync-release-notes.mjs",
    "publish": "changeset publish",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.5.0",
    "turbo": "latest",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.20.0"
}
